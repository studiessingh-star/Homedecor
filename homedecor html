<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nest &amp; Co | Home Decor</title>
  <link rel="stylesheet" href="homedecor.css">
</head>
<body>

  <!-- Header -->
  <header>
    <div class="container nav">
      <a href="#" class="logo">Nest &amp; Co</a>
      <nav>
        <a href="#home">Home</a>
        <a href="#categories">Categories</a>
        <a href="#products">Shop</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section id="home" class="hero">
    <div class="container">
      <h1>Make Your Home Feel Like You</h1>
      <p>Simple, beautiful decor for every room.</p>
      <a href="#products" class="btn">Shop Now</a>
    </div>
  </section>

  <!-- Categories -->
  <section id="categories" class="section">
    <div class="container">
      <h2>Shop by Category</h2>
      <div class="grid">
        <div class="category c1">Living Room</div>
        <div class="category c2">Bedroom</div>
        <div class="category c3">Kitchen</div>
        <div class="category c4">Lighting</div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="section light">
    <div class="container">
      <h2>Featured Products</h2>
      <div class="grid">
        <div class="card">
          <div class="img p1">🪴</div>
          <h3>Ceramic Plant Pot</h3>
          <p class="price">₹799</p>
          <button>Add to Cart</button>
        </div>
        <div class="card">
          <div class="img p2">🕯️</div>
          <h3>Scented Candle Set</h3>
          <p class="price">₹599</p>
          <button>Add to Cart</button>
        </div>
        <div class="card">
          <div class="img p3">🛋️</div>
          <h3>Cushion Cover (Pair)</h3>
          <p class="price">₹899</p>
          <button>Add to Cart</button>
        </div>
        <div class="card">
          <div class="img p4">💡</div>
          <h3>Warm Table Lamp</h3>
          <p class="price">₹1,499</p>
          <button>Add to Cart</button>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container about">
      <h2>About Us</h2>
      <p>At Nest &amp; Co, we believe a home should be calm, cozy and full of personality. We pick simple, well-made pieces that help you turn any space into your favourite place.</p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section light">
    <div class="container">
      <h2>Contact Us</h2>
      <form class="form">
        <input type="text" placeholder="Your Name" required>
        <input type="email" placeholder="Your Email" required>
        <textarea rows="4" placeholder="Your Message" required></textarea>
        <button type="submit">Send Message</button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Nest &amp; Co. All rights reserved.</p>
  </footer>

</body>
</html>
